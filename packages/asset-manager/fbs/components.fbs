include "common.fbs";

namespace FBSEngine;

table TransformEditor{
    euler: Vec3;
}

table Transform{
    id: string;
    pos: Vec3;
    rot: Vec4;
    scale: Vec3;
    editor: TransformEditor;
}

table Mesh{
    id: string;
    mesh_ref: string;
}

table SimpleShading{
    id: string;
    culling: string;
    transparent: bool;
    color: Vec3;
}

table Image{
    image_ref: string;
}
table Color{
    color: Vec3;
}
table Value{
    value: double;
}
table None{}
union ImageOrColor{
    Image,
    Color
}
union ImageOrValue{
    Image,
    Value
}
union OptionalImage{
    Image,
    None
}
table Emissive{
    color: ImageOrColor;
    intensity: double;
}

table PhongShading{
    id: string;
    culling: string;
    transparent: bool;
    diffuse: ImageOrColor;
    specular: Vec3;
    shininess: double;
}

table PbrShading{
    id: string;
    culling: string;
    transparent: bool;
    diffuse: ImageOrColor;
    metallic: ImageOrValue;
    roughness: ImageOrValue;
    reflectance: double;
    emissive: Emissive;
    normal: OptionalImage;
    ao: OptionalImage;
}

table LightShadow{
    enable: bool;
    bias: double;
    normalBias: double;
    mapSize: int;
    softShadow: string;
}

table DirectionalLight{
    id: string;
    color: Vec3;
    intensity: double;
    shadow: LightShadow;
}

table PointLight{
    id: string;
    color: Vec3;
    intensity: double;
    radius: double;
    shadow: LightShadow;
}

table SpotLight{
    id: string;
    color: Vec3;
    intensity: double;
    radius: double;
    innerAngle: double;
    outerAngle: double;
    shadow: LightShadow;
}

table SkyBox{
    id: string;
    hdrRef: string;
}

union Component{
    Transform,
    Mesh,
    SimpleShading,
    PhongShading,
    PbrShading,
    PointLight,
    DirectionalLight,
    SpotLight,
    SkyBox
}
