include "common.fbs";

namespace FBSEngine;

table TransformEditor{
    euler: Vec3;
}

table Transform{
    id: string;
    pos: Vec3;
    rot: Vec4;
    scale: Vec3;
    editor: TransformEditor;
}

table MeshRenderer{
    id: string;
    mesh_ref: string;
    material_refs: [string];
}

table SkinnedMeshRenderer{
    id: string;
    mesh_ref: string;
    material_refs: [string];
    joint_refs: [string];
}

table LightShadow{
    enable: bool;
    bias: double;
    normalBias: double;
    mapSize: int;
    softShadow: string;
}

table DirectionalLight{
    id: string;
    color: Vec3;
    intensity: double;
    shadow: LightShadow;
}

table PointLight{
    id: string;
    color: Vec3;
    intensity: double;
    radius: double;
    shadow: LightShadow;
}

table SpotLight{
    id: string;
    color: Vec3;
    intensity: double;
    radius: double;
    innerAngle: double;
    outerAngle: double;
    shadow: LightShadow;
}

table Camera{
    id: string;
    fovy: double;
}

table SkyBox{
    id: string;
    hdrRef: string;
}

table Skeleton{
    id: string;
    rootJointId: string;
}

table Text{
    text_ref: string;
}
table String{
    value: string;
}
union TextOrString{
    Text,
    String
}
table UILayout{
    id: string;
    html: TextOrString;
    css: TextOrString;
    js: TextOrString;
}

union Component{
    Transform,
    MeshRenderer,
    SkinnedMeshRenderer,
    PointLight,
    DirectionalLight,
    SpotLight,
    Camera,
    SkyBox,
    Skeleton,
    UILayout
}
