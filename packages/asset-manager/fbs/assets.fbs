include "engine.fbs";

namespace FBSEngine;

table ImageAsset{
    width: uint;
    height: uint;
    data: [ubyte];
}

table PrimitiveAttribute{
    interleaveArray: [uint8];
}

enum IndexType : uint {
    NONE = 0,
    UNSIGNED_BYTE = 5121,
    UNSIGNED_SHORT = 5123,
    UNSIGNED_INT = 5125
}

table AABB{
    min: Vec3;
    max: Vec3;
}

enum PrimitiveType : uint {
    NONE = 0,
    STATIC = 1,
    SKIN = 2
}

table Primitive{
    type: PrimitiveType;
    attribute: PrimitiveAttribute;
    indices: [ubyte];
    index_type: IndexType;
    drawMode: int;
    aabb: AABB;
    invBindPoseMatrices: [float];
}

table MeshAsset{
    primitives: [Primitive];
}

table PrefabAsset{
    root: GameObject;
}

table SceneAsset{
    scene: Scene;
}

table HdrImage{
    width: uint;
    height: uint;
    data: [float];
}

table HdrCube{
    right: HdrImage;
    left: HdrImage;
    top: HdrImage;
    bottom: HdrImage;
    font: HdrImage;
    back: HdrImage;
}

table PrefilterMap{
    mipMapCount: uint;
    mipMaps: [HdrCube];
}

table HdrAsset{
    enviromentMap: HdrCube;
    irradianceMap: HdrCube;
    prefilterMap: PrefilterMap;
    brdfLUT: HdrImage;
}

table FontAssetBakeSetting{
    field_type: ushort;
    font_size: int;
    texture_width: int;
    texture_height: int;
}

table FontInfoChar{
    id: int;
    char: string;
    xoffset: int;
    yoffset: int;
    width: int;
    height: int;
    xadvance: int;
    x: int;
    y: int;
    page: int;
}

table FontInfoCommon{
    lineHeight: int;
}

table FontInfo{
    chars: [FontInfoChar];
    common: FontInfoCommon;
}

table AtlasTexture{
    data: [ubyte];
}

table FontAsset{
    font_asset_bake_setting: FontAssetBakeSetting;
    atlas_textures: [AtlasTexture];
    font_info: FontInfo;
}
