include "../engine.fbs";

namespace FBSAsset;

table GLTypeAndNormalized{
  type: int;
  normalized: bool;
  item_size: int;
  count: int;
}

table PrimitiveAttribute{
  interleave_array: [uint8];
  position: GLTypeAndNormalized;
  normal: GLTypeAndNormalized;
  uv: GLTypeAndNormalized;
  tangent: GLTypeAndNormalized;
  joint: GLTypeAndNormalized;
  weight: GLTypeAndNormalized;
}

table AABB{
  min: FBSEngine.Vec3;
  max: FBSEngine.Vec3;
}

table Primitive{
  attribute: PrimitiveAttribute;
  indices: [ubyte];
  index_type: int;
  index_count: int;
  draw_mode: int;
  aabb: AABB;
}

table MeshAsset{
  primitives: [Primitive];
  inv_bind_pose_matrices: [float];
}

root_type MeshAsset;