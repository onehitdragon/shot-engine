include "../engine.fbs";

namespace FBSAsset;

table PrimitiveAttribute{
  interleaveArray: [uint8];
}

table AABB{
  min: FBSEngine.Vec3;
  max: FBSEngine.Vec3;
}

enum PrimitiveType : uint {
  NONE = 0,
  STATIC = 1,
  SKIN = 2
}

table Primitive{
  type: PrimitiveType;
  attribute: PrimitiveAttribute;
  indices: [ubyte];
  drawMode: int;
  aabb: AABB;
  invBindPoseMatrices: [float];
}

table MeshAsset{
  primitives: [Primitive];
}

root_type MeshAsset;