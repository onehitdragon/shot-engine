include "../engine.fbs";

namespace FBSAsset;

table HdrImage{
  width: uint;
  height: uint;
  data: [float];
}

table HdrCube{
  right: HdrImage;
  left: HdrImage;
  top: HdrImage;
  bottom: HdrImage;
  font: HdrImage;
  back: HdrImage;
}

table PrefilterMap{
  mipMapCount: uint;
  mipMaps: [HdrCube];
}

table HdrAsset{
  enviromentMap: HdrCube;
  irradianceMap: HdrCube;
  prefilterMap: PrefilterMap;
  brdfLUT: HdrImage;
}

root_type HdrAsset;
